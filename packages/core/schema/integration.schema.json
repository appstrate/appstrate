                  "required": [
                    "value"
                  ],
                  "additionalProperties": {}
                }
              },
              "files": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "value": {
                      "type": "string",
                      "minLength": 1
                    },
                    "mode": {
                      "type": "string",
                      "pattern": "^0[0-7]{3}$"
                    }
                  },
                  "required": [
                    "value"
                  ],
                  "additionalProperties": {}
                }
              }
            },
            "additionalProperties": {},
            "allOf": [
              {
                "anyOf": [
                  {
                    "required": [
                      "http"
                    ]
                  },
                  {
                    "required": [
                      "env"
                    ]
                  },
                  {
                    "required": [
                      "files"
                    ]
                  }
                ]
              },
              {
                "if": {
                  "required": [
                    "http"
                  ]
                },
                "then": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "env"
                        ]
                      },
                      {
                        "required": [
                          "files"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "authorized_uris": {
            "type": "array",
