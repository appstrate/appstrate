            },
            "then": {
              "properties": {
                "type": {
                  "enum": [
                    "custom",
                    "oauth2"
                  ]
                },
                "connect": {
                  "oneOf": [
                    {
                      "required": [
                        "login"
                      ],
                      "not": {
                        "required": [
                          "tool"
                        ]
                      }
                    },
                    {
                      "required": [
                        "tool"
                      ],
                      "not": {
                        "required": [
                          "login"
                        ]
                      }
                    }
                  ]
                }
              },
              "required": [
                "type"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
