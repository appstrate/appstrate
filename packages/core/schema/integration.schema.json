                },
                "credentials": {
                  "required": [
                    "schema"
                  ]
                },
                "connect": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "tool"
                        ]
                      },
                      {
                        "required": [
                          "limits"
                        ]
                      }
                    ]
                  },
                  "properties": {
                    "login": {
                      "not": {
                        "anyOf": [
                          {
                            "required": [
                              "outputs"
                            ]
                          },
                          {
                            "required": [
                              "success_criteria"
                            ]
                          },
                          {
                            "required": [
                              "expires_in_output"
                            ]
                          },
                          {
                            "required": [
                              "identity_outputs"
                            ]
                          }
                        ]
                      },
                      "properties": {
                        "request": {
                          "required": [
