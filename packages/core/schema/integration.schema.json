                {
                  "pattern": "^(\\{\\$variable\\.[a-z][a-z0-9_]*\\})(?:\\/[^{}]*)?$"
                },
                {
                  "pattern": "^([A-Za-z][A-Za-z0-9+.-]*:\\/\\/\\{\\$variable\\.[a-z][a-z0-9_]*\\}(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]*[A-Za-z0-9])?)*(?::[0-9]+)?)(?:[/?#][^{}]*)?$"
                }
              ]
            }
          },
          "allow_all_uris": {
            "type": "boolean"
          },
          "callback_url_hint": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "delivery"
        ],
        "additionalProperties": {},
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "api_key",
                    "basic",
                    "mtls",
                    "custom"
                  ]
                }
              },
              "required": [
                "type"
              ]
            },
            "then": {
              "required": [
                "credentials"
              ],
              "properties": {
