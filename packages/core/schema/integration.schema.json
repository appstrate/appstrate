              },
              "required": [
                "type",
                "connect"
              ]
            },
            "then": {
              "required": [
                "token_endpoint",
                "credentials"
              ],
              "not": {
                "required": [
                  "scope_catalog"
                ]
              },
              "properties": {
                "issuer": {
                  "not": {
                    "pattern": "\\{\\$"
