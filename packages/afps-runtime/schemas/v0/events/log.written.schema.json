{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.afps.dev/v0/events/log.written.schema.json",
  "$comment": "SPDX-License-Identifier: Apache-2.0 — Copyright 2026 Appstrate",
  "title": "AFPS log.written event data",
  "description": "CloudEvent `data` payload for `log.written` — a severity-tagged log line emitted by the AFPS `log()` tool (@afps/log).",
  "type": "object",
  "properties": {
    "level": {
      "type": "string",
      "enum": [
        "info",
        "warn",
        "error"
      ],
      "description": "Severity of the log line."
    },
    "message": {
      "type": "string",
      "description": "Human-readable log message."
    }
  },
  "required": [
    "level",
    "message"
  ],
  "additionalProperties": {}
}
