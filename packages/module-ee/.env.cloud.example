# Appstrate Cloud — Environment Variables
#
# Copy to .env:  cp .env.cloud.example .env
# Then fill in the required values below.

# ═══════════════════════════════════════════════════
# OSS Variables (required)
# ═══════════════════════════════════════════════════

# Database
POSTGRES_PASSWORD=change-me
POSTGRES_USER=appstrate

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Connection encryption (generate: openssl rand -base64 32)
CONNECTION_ENCRYPTION_KEY=

# S3 / MinIO
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=appstrate
S3_REGION=us-east-1

# App
APP_URL=http://localhost:3000
# TRUSTED_ORIGINS=https://your-domain.com

# System provider keys (JSON array — pre-configured LLM credentials)
# SYSTEM_PROVIDER_KEYS='[{"id":"anthropic","label":"Anthropic","api":"anthropic-messages","baseUrl":"https://api.anthropic.com","apiKey":"sk-ant-...","models":[{"modelId":"claude-sonnet-4-6","label":"Claude Sonnet 4.6","isDefault":true}]}]'

# Run
# RUN_ADAPTER=docker
# SIDECAR_POOL_SIZE=2

# Version (default: latest)
# APPSTRATE_VERSION=latest

# Logging
# LOG_LEVEL=info

# ═══════════════════════════════════════════════════
# Cloud Variables (required)
# ═══════════════════════════════════════════════════

# Stripe API
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from your Stripe dashboard)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...

# Cloud billing database (separate logical database from the platform DB).
# The module creates it at boot when it is missing — via the server's `postgres`
# maintenance database with the same credentials — so on a fresh Postgres the
# role needs CREATEDB once; a role without it gets an error naming the
# `createdb` command to run. With docker-compose.yml CLOUD_DATABASE_URL is
# derived from POSTGRES_USER/POSTGRES_PASSWORD. Set it explicitly ONLY to point
# cloud at an external/managed Postgres instead.
# CLOUD_DATABASE_URL=postgresql://user:pass@host:5432/appstrate_cloud
