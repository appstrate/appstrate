# Dependencies. `**/` is required: .dockerignore patterns are anchored at the
# context root and are NOT recursive (unlike .gitignore), so a bare
# `node_modules` would leave every workspace member's nested tree in the
# context — and the root Dockerfile's `COPY . .` would then overwrite the
# node_modules the deps stage just built.
**/node_modules
.git
.turbo
.bun
.DS_Store
.eslintcache

# Agent worktrees (each is a full repo checkout — gigabytes of build context)
.claude/
.worktrees/

# Markdown (except important ones)
*.md
!apps/api/src/**/*.md

# Environment
.env
.env.*
!.env.example

# Test and coverage
**/test/
**/tests/
**/coverage/

# Logs
*.log

# Lint and format configs
.prettier*
.eslint*

# Documentation and configs (not needed in images)
docs/
scripts/
.github/
.husky/
CLAUDE.md
CONTRIBUTING.md
CHANGELOG.md
CODE_OF_CONDUCT.md
SECURITY.md
TRADEMARK.md
bunfig.toml
commitlint.config.ts
eslint.config.mjs
.editorconfig
.prettierrc
.gitattributes

# Local runtime + scratch state. Root-anchored (see the `**/` note above), so
# these never shadow vendored source dirs like apps/api/src/data/.
data/
storage/
local-test-packages/
scratch/
undefined/

# Docker files (not needed inside images)
Dockerfile*
docker-compose*
