{
  "name": "appstrate-docs",
  "private": true,
  "description": "The public documentation site (docs.appstrate.com): a static Next.js export built from docs/site, docs/ENV.md and the OpenAPI spec of this commit.",
  "type": "module",
  "scripts": {
    "content": "bun ../../scripts/export-openapi.ts openapi.json && bun scripts/sync-content.ts",
    "dev": "bun run content && next dev -p 3480",
    "build": "bun run content && next build && bun scripts/postbuild.ts",
    "preview": "wrangler pages dev --port 3480",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "deploy": "wrangler pages deploy"
  },
  "dependencies": {
    "fumadocs-core": "16.7.16",
    "fumadocs-mdx": "14.3.0",
    "fumadocs-openapi": "10.7.1",
    "fumadocs-ui": "16.7.16",
    "geist": "^1.7.0",
    "lucide-react": "~1.8.0",
    "next": "~16.2.4",
    "react": "~19.2.5",
    "react-dom": "~19.2.5",
    "shiki": "^3.23.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "~4.2.2",
    "@types/bun": "^1.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22.19.17",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.10",
    "tailwindcss": "~4.2.2",
    "typescript": "^5.9.3",
    "wrangler": "^4.42.0"
  }
}
