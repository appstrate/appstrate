{
  "name": "@appstrate/twilio",
  "version": "1.1.0",
  "type": "integration",
  "schema_version": "0.3",
  "display_name": "Twilio (API)",
  "description": "Cloud communications platform for SMS, voice, and messaging",
  "keywords": ["messaging", "communications"],
  "license": "Apache-2.0",
  "icon": "logos:twilio-icon",
  "source": {
    "kind": "none"
  },
  "default_tools": ["api_call"],
  "auths": {
    "primary": {
      "type": "api_key",
      "authorized_uris": [
        "https://accounts.twilio.com/**",
        "https://api.twilio.com/**",
        "https://bulkexports.twilio.com/**",
        "https://chat.twilio.com/**",
        "https://content.twilio.com/**",
        "https://conversations.twilio.com/**",
        "https://events.twilio.com/**",
        "https://flex-api.twilio.com/**",
        "https://frontline-api.twilio.com/**",
        "https://iam.twilio.com/**",
        "https://insights.twilio.com/**",
        "https://intelligence.twilio.com/**",
        "https://ip-messaging.twilio.com/**",
        "https://knowledge.twilio.com/**",
        "https://lookups.twilio.com/**",
        "https://marketplace.twilio.com/**",
        "https://memory.twilio.com/**",
        "https://messaging.twilio.com/**",
        "https://monitor.twilio.com/**",
        "https://notify.twilio.com/**",
        "https://numbers.twilio.com/**",
        "https://oauth.twilio.com/**",
        "https://preview-iam.twilio.com/**",
        "https://preview.twilio.com/**",
        "https://pricing.twilio.com/**",
        "https://proxy.twilio.com/**",
        "https://routes.twilio.com/**",
        "https://serverless.twilio.com/**",
        "https://studio.twilio.com/**",
        "https://supersim.twilio.com/**",
        "https://sync.twilio.com/**",
        "https://taskrouter.twilio.com/**",
        "https://trunking.twilio.com/**",
        "https://trusthub.twilio.com/**",
        "https://verify.twilio.com/**",
        "https://video.twilio.com/**",
        "https://voice.twilio.com/**",
        "https://wireless.twilio.com/**"
      ],
      "credentials": {
        "schema": {
          "type": "object",
          "properties": {
            "account_sid": {
              "type": "string",
              "title": "Account SID",
              "description": "Identifiant du compte Twilio (commence par AC), sur la page d'accueil de la console, encadré Account Info."
            },
            "auth_token": {
              "type": "string",
              "title": "Auth Token",
              "description": "Auth Token du compte, sur la même page (Account Info). Il donne un accès complet au compte."
            }
          },
          "required": ["account_sid", "auth_token"]
        }
      },
      "delivery": {
        "http": {
          "in": "header",
          "name": "Authorization",
          "prefix": "Basic ",
          "value": "{$credential.account_sid}:{$credential.auth_token}",
          "encoding": "base64"
        }
      },
      "_meta": {
        "dev.appstrate/auth": {
          "required": true
        }
      }
    }
  },
  "_meta": {
    "dev.appstrate/package": {
      "author": "Appstrate"
    },
    "dev.appstrate/api": {
      "auths": {
        "primary": {}
      }
    }
  }
}
