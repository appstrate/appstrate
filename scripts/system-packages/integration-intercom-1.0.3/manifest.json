{
  "name": "@appstrate/intercom",
  "version": "1.0.3",
  "type": "integration",
  "schema_version": "0.1",
  "display_name": "Intercom (API)",
  "description": "Customer messaging and support platform",
  "keywords": ["customer-support", "messaging"],
  "license": "Apache-2.0",
  "icon": "logos:intercom",
  "source": {
    "kind": "none"
  },
  "default_tools": ["api_call"],
  "setup_guide": {
    "steps": [
      {
        "label": "Créer une app dans le Developer Hub Intercom",
        "url": "https://app.intercom.com/a/developer-signup"
      }
    ]
  },
  "auths": {
    "primary": {
      "type": "oauth2",
      "authorization_endpoint": "https://app.intercom.com/oauth",
      "token_endpoint": "https://api.intercom.io/auth/eagle/token",
      "userinfo_endpoint": "https://api.intercom.io/me",
      "identity_claims": {
        "accountId": "$.email",
        "sub": "$.id",
        "email": "$.email",
        "name": "$.name"
      },
      "token_endpoint_auth_method": "client_secret_post",
      "authorized_uris": ["https://api.intercom.io/**"],
      "delivery": {
        "http": {
          "in": "header",
          "name": "Authorization",
          "prefix": "Bearer",
          "value": "{$credential.access_token}"
        }
      },
      "_meta": {
        "dev.appstrate/oauth": {
          "scope_separator": " "
        },
        "dev.appstrate/auth": {
          "required": true
        }
      }
    }
  },
  "_meta": {
    "dev.appstrate/package": {
      "author": "Appstrate"
    },
    "dev.appstrate/api": {
      "auths": {
        "primary": {}
      }
    }
  }
}
