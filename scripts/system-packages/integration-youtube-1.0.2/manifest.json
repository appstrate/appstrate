{
  "name": "@appstrate/youtube",
  "version": "1.0.2",
  "type": "integration",
  "schema_version": "0.1",
  "display_name": "YouTube (API)",
  "description": "Video sharing and streaming platform by Google",
  "keywords": ["social-media", "video", "marketing"],
  "license": "Apache-2.0",
  "icon": "logos:youtube-icon",
  "source": {
    "kind": "none"
  },
  "default_tools": ["api_call"],
  "setup_guide": {
    "steps": [
      {
        "label": "Créer ou sélectionner un projet Google Cloud",
        "url": "https://console.cloud.google.com/projectcreate"
      },
      {
        "label": "Configurer l'écran de consentement OAuth",
        "url": "https://console.cloud.google.com/auth/overview"
      },
      {
        "label": "Créer un ID client OAuth de type « Application Web »",
        "url": "https://console.cloud.google.com/apis/credentials"
      }
    ]
  },
  "auths": {
    "primary": {
      "type": "oauth2",
      "authorization_endpoint": "https://accounts.google.com/o/oauth2/v2/auth",
      "token_endpoint": "https://oauth2.googleapis.com/token",
      "callback_url_hint": "Champ « Authorized redirect URIs » de l'ID client OAuth — enregistrer exactement : {{callback_url}}",
      "default_scopes": ["https://www.googleapis.com/auth/youtube.readonly"],
      "token_endpoint_auth_method": "client_secret_post",
      "scope_catalog": [
        {
          "value": "https://www.googleapis.com/auth/youtube.readonly",
          "label": "Read-only access (videos, channels, playlists)"
        },
        {
          "value": "https://www.googleapis.com/auth/youtube",
          "label": "Full access (manage account)"
        },
        {
          "value": "https://www.googleapis.com/auth/youtube.upload",
          "label": "Upload videos"
        },
        {
          "value": "https://www.googleapis.com/auth/youtube.force-ssl",
          "label": "Manage videos, comments, captions (SSL required)"
        },
        {
          "value": "https://www.googleapis.com/auth/youtubepartner",
          "label": "YouTube Partner (content & rights management)"
        },
        {
          "value": "https://www.googleapis.com/auth/youtube.channel-memberships.creator",
          "label": "Read channel memberships"
        }
      ],
      "authorized_uris": [
        "https://www.googleapis.com/youtube/**",
        "https://youtube.googleapis.com/**",
        "https://www.googleapis.com/upload/youtube/**"
      ],
      "delivery": {
        "http": {
          "in": "header",
          "name": "Authorization",
          "prefix": "Bearer",
          "value": "{$credential.access_token}"
        }
      },
      "_meta": {
        "dev.appstrate/oauth": {
          "scope_separator": " "
        },
        "dev.appstrate/auth": {
          "required": true
        }
      }
    }
  },
  "_meta": {
    "dev.appstrate/package": {
      "author": "Appstrate"
    },
    "dev.appstrate/api": {
      "auths": {
        "primary": {}
      }
    }
  }
}
