{
  "name": "@appstrate/vapi",
  "version": "1.0.0",
  "type": "integration",
  "schema_version": "0.3",
  "display_name": "Vapi (API)",
  "description": "Voice AI platform — place outbound phone calls run by a voice assistant and read back the answers",
  "keywords": ["voice", "phone-calls", "ai"],
  "license": "Apache-2.0",
  "source": {
    "kind": "none"
  },
  "default_tools": ["api_call"],
  "auths": {
    "primary": {
      "type": "api_key",
      "authorized_uris": ["https://api.vapi.ai/**"],
      "credentials": {
        "schema": {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string",
              "writeOnly": true,
              "description": "Vapi private API key (Dashboard → API Keys), not the public key"
            }
          },
          "required": ["api_key"]
        }
      },
      "delivery": {
        "http": {
          "in": "header",
          "name": "Authorization",
          "prefix": "Bearer ",
          "value": "{$credential.api_key}"
        }
      },
      "_meta": {
        "dev.appstrate/auth": {
          "required": true
        }
      }
    }
  },
  "_meta": {
    "dev.appstrate/package": {
      "author": "Appstrate"
    },
    "dev.appstrate/api": {
      "auths": {
        "primary": {}
      }
    }
  }
}
