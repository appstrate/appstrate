{
  "name": "appstrate",
  "version": "0.0.0",
  "description": "Official CLI for Appstrate — install, login, and manage your instance",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "bun": ">=1.3.9"
  },
  "publishConfig": {
    "provenance": true
  },
  "author": "Appstrate <hello@appstrate.dev>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/appstrate/appstrate.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/appstrate/appstrate/tree/main/apps/cli",
  "bugs": {
    "url": "https://github.com/appstrate/appstrate/issues"
  },
  "keywords": [
    "appstrate",
    "cli",
    "bunx",
    "device-flow",
    "oauth",
    "self-hosting"
  ],
  "bin": {
    "appstrate": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test test/",
    "build": "bun scripts/build.ts",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^13.0.0",
    "@clack/prompts": "^1.8.1",
    "@earendil-works/pi-ai": "0.86.1",
    "@earendil-works/pi-coding-agent": "0.86.1",
    "@napi-rs/keyring": "^2.1.0",
    "async-mutex": "^0.5.0",
    "commander": "^15.0.0",
    "open": "^11.0.4",
    "smol-toml": "^1.7.1",
    "write-file-atomic": "^8.0.0"
  },
  "devDependencies": {
    "@appstrate/afps-runtime": "workspace:*",
    "@appstrate/afps-shared": "workspace:*",
    "@appstrate/core": "workspace:*",
    "@appstrate/runner-pi": "workspace:*",
    "@appstrate/shared-types": "workspace:*",
    "@types/bun": "latest",
    "@types/write-file-atomic": "^4.0.3"
  }
}
