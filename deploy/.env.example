# Appstrate — Deployment Environment Variables
#
# Copy to .env:  cp .env.example .env
# Then fill in the required values below.

# ═══════════════════════════════════════════════════
# OSS Variables (required)
# ═══════════════════════════════════════════════════

# Database
POSTGRES_PASSWORD=change-me
POSTGRES_USER=appstrate

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Connection encryption (generate: openssl rand -base64 32)
CONNECTION_ENCRYPTION_KEY=

# The three remaining secrets the platform REFUSES TO BOOT without. They are
# not optional and they have no default: `packages/env/src/index.ts` declares
# each `.min(1, "… is required")`, and the upload and connect secrets also
# require every comma-separated key to be at least 16 chars.
#
# This file omitted all three until 2026-09-18 and nobody noticed, because
# Coolify injects the variables configured on the resource into the containers
# whatever the compose file says. A raw `docker compose up` from this directory
# did NOT boot. Generate each with `openssl rand -hex 32`.
RUN_TOKEN_SECRET=
UPLOAD_SIGNING_SECRET=
CONNECT_SESSION_SECRET=

# S3 / MinIO
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=appstrate
S3_REGION=us-east-1
# Presigned URLs are served to browsers, so they cannot name `appstrate-minio`
# — a Docker hostname nothing outside the compose network resolves. Set this to
# the public MinIO origin; it falls back to S3_ENDPOINT, which is the internal
# one.
# S3_PUBLIC_ENDPOINT=https://storage.example.com

# App
APP_URL=http://localhost:3000
# TRUSTED_ORIGINS=https://your-domain.com

# System provider keys (JSON array — pre-configured LLM credentials)
# SYSTEM_PROVIDER_KEYS='[{"id":"anthropic","label":"Anthropic","api":"anthropic-messages","baseUrl":"https://api.anthropic.com","apiKey":"sk-ant-...","models":[{"modelId":"claude-sonnet-4-6","label":"Claude Sonnet 4.6","isDefault":true}]}]'

# Run
# RUN_ADAPTER=docker

# Version — the release tag WITHOUT the leading `v`. The compose falls back to
# the same value when this is unset; set it explicitly so the deployed version
# is readable from the environment, not inferred from the file.
# APPSTRATE_VERSION=1.0.0-beta.58

# Logging
# LOG_LEVEL=info

# ═══════════════════════════════════════════════════
# Billing — @appstrate/module-ee (required when it is in MODULES)
# ═══════════════════════════════════════════════════

# Stripe API
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from your Stripe dashboard)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...

# There is NO second database. `@appstrate/module-ee` keeps its seven `ee_*`
# tables in the platform database (DATABASE_URL), under a migration journal of
# its own (`drizzle.ee_migrations`), and migrates them itself at init().
#
# A deployment that ran the former out-of-tree module against `appstrate_cloud`
# moves those rows across ONCE, with the platform stopped, using
# `scripts/migration/0010-ee-tables-into-platform-db.ts` in the appstrate
# monorepo — then deletes CLOUD_DATABASE_URL. Skipping it makes the module
# create seven empty tables and every organization loses its billing account.
#
# MODULES is what turns billing on. Leave `@appstrate/module-ee` out of it and
# the platform runs with no billing footprint and needs none of the keys above.
