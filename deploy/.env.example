# Appstrate — Deployment Environment Variables
#
# Copy to .env:  cp .env.example .env
# Then fill in the required values below.

# ═══════════════════════════════════════════════════
# OSS Variables (required)
# ═══════════════════════════════════════════════════

# Database
POSTGRES_PASSWORD=change-me
POSTGRES_USER=appstrate

# Auth
BETTER_AUTH_SECRET=change-me-to-a-random-secret

# Connection encryption (generate: openssl rand -base64 32)
CONNECTION_ENCRYPTION_KEY=

# The three remaining secrets the platform REFUSES TO BOOT without. No
# defaults: `packages/env/src/index.ts` declares each `.min(1, "… is
# required")`, and the upload and connect secrets also require every
# comma-separated key to be at least 16 chars. Generate each with
# `openssl rand -hex 32`.
RUN_TOKEN_SECRET=
UPLOAD_SIGNING_SECRET=
CONNECT_SESSION_SECRET=

# Modules — REQUIRED by this deployment, with no default. docker-compose.yml
# reads the variable as `${MODULES:?}`: left unset or empty, Coolify refuses to
# deploy and `docker compose` refuses to start, rather than falling back to the
# code default, which names no billing module. This deployment bills, so the
# comma-separated list must include `@appstrate/module-ee` alongside the other
# modules it runs (docs/ENV.md lists the specifiers). Set it on the Coolify
# resource, or add the assignment to .env for a raw run.

# S3 / MinIO
MINIO_ROOT_PASSWORD=change-me
S3_BUCKET=appstrate
S3_REGION=us-east-1
# Presigned URLs are served to browsers, so they cannot name `appstrate-minio`
# — a Docker hostname nothing outside the compose network resolves. Set this to
# the public MinIO origin; it falls back to S3_ENDPOINT, which is the internal
# one.
# S3_PUBLIC_ENDPOINT=https://storage.example.com

# App
APP_URL=http://localhost:3000
# TRUSTED_ORIGINS=https://your-domain.com

# Honour X-Forwarded-For. Set this to 1 when — and ONLY when — a reverse proxy
# terminates client connections and writes those headers itself. Directly
# exposed, it lets any client spoof their source IP and walk past every per-IP
# rate limit. The Coolify deployment sits behind Traefik and sets it to 1.
# TRUST_PROXY=1

# Where browsers fetch signed file previews. Every preview_url this instance
# issues points at it, so an unrouted host means dead previews with no
# server-side trace.
# USERCONTENT_URL=https://static.example.com

# System provider keys (JSON array — pre-configured LLM credentials)
# SYSTEM_PROVIDER_KEYS='[{"id":"anthropic","label":"Anthropic","api":"anthropic-messages","baseUrl":"https://api.anthropic.com","apiKey":"sk-ant-...","models":[{"modelId":"claude-sonnet-4-6","label":"Claude Sonnet 4.6","isDefault":true}]}]'

# Run
# RUN_ADAPTER=docker

# Version — the release tag WITHOUT the leading `v`. The compose falls back to
# the same value when this is unset; set it explicitly so the deployed version
# is readable from the environment, not inferred from the file.
# APPSTRATE_VERSION=1.0.0-beta.61

# Logging
# LOG_LEVEL=info

# ═══════════════════════════════════════════════════
# Billing — @appstrate/module-ee (required when it is in MODULES)
# ═══════════════════════════════════════════════════

# Stripe API
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (from your Stripe dashboard)
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...

# Billing sweeper knobs. All four have defaults in
# `packages/module-ee/src/env.ts` and are listed here for discoverability, not
# because they must be set — LEAVING THEM UNSET IS THE SUPPORTED CHOICE.
#
# Set them only with a reason, and never to an empty string: two of them accept
# 0, and there 0 does not mean "default" but "off" — a zero interval pauses
# metering, and a zero replay window disables the scan that stops usage going
# silently unbilled. Read their docstrings in that file before touching either.
# EE_RECONCILIATION_INTERVAL_SECONDS=300
# EE_RECONCILIATION_BATCH_SIZE=100
# EE_RECONCILIATION_REPLAY_WINDOW=200
# EE_RECONCILIATION_MAX_GAP_SECONDS=86400

# There is NO second database and no second URL. `@appstrate/module-ee` keeps
# its seven `ee_*` tables in the platform database (DATABASE_URL), under a
# migration journal of its own (`drizzle.ee_migrations`), and migrates them
# itself at init().
#
# MODULES is what turns billing on — see the Modules note near the top. Without
# `@appstrate/module-ee` in it the platform runs with no billing footprint and
# needs none of the keys above, which is why this deployment must name it.
